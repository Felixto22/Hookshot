#version 450
// (felix) AMD FidelityFX Super Resolution 1, EASU (Edge Adaptive Spatial Upsampling), in place of the plain linear
// upscale the TAAU stand-in does on cards that cannot run OoT's TAAU network (vk_draw.cpp taau_stand_in, AMD and
// Intel). A port of ffx_fsr1.h's FsrEasuF (MIT, Copyright (c) 2021 Advanced Micro Devices, Inc.) to plain GLSL
// floats: 12 taps around the output pixel, a direction and an edge length from the luma of the four nearest, and a
// Lanczos-like lobe stretched along the edge, clamped to the four nearest texels (no ringing).
//
// The input is the network's perceptual encoding (the square root of the scene colour, see taau_upscale.comp), the
// gamma-like space EASU was made for. The result stays in that space in `dst` (RGBA16F): fsr1_rcas.comp sharpens it
// and squares it back for the network's output.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba16f) uniform writeonly image2D dst;
// in: the input's size; out: the output's size
layout(push_constant) uniform P { ivec2 in_size; ivec2 out_size; } pc;

vec3 tap(ivec2 p) { return texelFetch(src, clamp(p, ivec2(0), pc.in_size - 1), 0).rgb; }
float luma(vec3 c) { return c.b * 0.5 + (c.r * 0.5 + c.g); }

// one of the four bilinear corners' contribution to the direction and the edge length (FsrEasuSetF)
void set_corner(inout vec2 dir, inout float len, float w, float lA, float lB, float lC, float lD, float lE) {
    // lA above, lB left, lC the corner, lD right, lE below
    float dc = lD - lC, cb = lC - lB;
    float lenX = max(abs(dc), abs(cb));
    lenX = lenX > 0.0 ? 1.0 / lenX : 0.0;
    float dirX = lD - lB;
    lenX = clamp(abs(dirX) * lenX, 0.0, 1.0);
    lenX *= lenX;
    float ec = lE - lC, ca = lC - lA;
    float lenY = max(abs(ec), abs(ca));
    lenY = lenY > 0.0 ? 1.0 / lenY : 0.0;
    float dirY = lE - lA;
    lenY = clamp(abs(dirY) * lenY, 0.0, 1.0);
    lenY *= lenY;
    dir += vec2(dirX, dirY) * w;
    len += (lenX + lenY) * w;
}

// one tap's weight (FsrEasuTapF)
void add_tap(inout vec3 acc, inout float accw, vec2 off, vec2 dir, vec2 len2, float lob, float clp, vec3 c) {
    vec2 v = vec2(off.x * dir.x + off.y * dir.y, off.x * -dir.y + off.y * dir.x) * len2;
    float d2 = min(v.x * v.x + v.y * v.y, clp);
    float wB = 0.4 * d2 - 1.0;
    float wA = lob * d2 - 1.0;
    wB *= wB;
    wA *= wA;
    wB = 1.5625 * wB - 0.5625;
    float w = wB * wA;
    acc += c * w;
    accw += w;
}

void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(g, pc.out_size))) return;
    const vec2 scale = vec2(pc.in_size) / vec2(pc.out_size);
    vec2 pp = (vec2(g) + 0.5) * scale - 0.5;
    const vec2 fp = floor(pp);
    pp -= fp;
    const ivec2 f0 = ivec2(fp);
    //    b c
    //  e f g h
    //  i j k l
    //    n o
    const vec3 b = tap(f0 + ivec2(0, -1)), c = tap(f0 + ivec2(1, -1));
    const vec3 e = tap(f0 + ivec2(-1, 0)), f = tap(f0), gg = tap(f0 + ivec2(1, 0)), h = tap(f0 + ivec2(2, 0));
    const vec3 i = tap(f0 + ivec2(-1, 1)), j = tap(f0 + ivec2(0, 1)), k = tap(f0 + ivec2(1, 1)), l = tap(f0 + ivec2(2, 1));
    const vec3 n = tap(f0 + ivec2(0, 2)), o = tap(f0 + ivec2(1, 2));
    const float bL = luma(b), cL = luma(c), eL = luma(e), fL = luma(f), gL = luma(gg), hL = luma(h);
    const float iL = luma(i), jL = luma(j), kL = luma(k), lL = luma(l), nL = luma(n), oL = luma(o);

    vec2 dir = vec2(0.0);
    float len = 0.0;
    set_corner(dir, len, (1.0 - pp.x) * (1.0 - pp.y), bL, eL, fL, gL, jL);
    set_corner(dir, len, pp.x * (1.0 - pp.y), cL, fL, gL, hL, kL);
    set_corner(dir, len, (1.0 - pp.x) * pp.y, fL, iL, jL, kL, nL);
    set_corner(dir, len, pp.x * pp.y, gL, jL, kL, lL, oL);

    // the direction normalized (none: along x)
    const vec2 dir2 = dir * dir;
    float dirR = dir2.x + dir2.y;
    const bool zro = dirR < 1.0 / 32768.0;
    dirR = zro ? 1.0 : inversesqrt(dirR);
    dir.x = zro ? 1.0 : dir.x;
    dir *= dirR;
    // the edge length: 0 (flat) to 1 (an edge), shaping the kernel
    len = len * 0.5;
    len *= len;
    const float stretch = (dir.x * dir.x + dir.y * dir.y) / max(abs(dir.x), abs(dir.y));
    const vec2 len2 = vec2(1.0 + (stretch - 1.0) * len, 1.0 - 0.5 * len);
    const float lob = 0.5 + ((1.0 / 4.0 - 0.04) - 0.5) * len;
    const float clp = 1.0 / lob;

    vec3 acc = vec3(0.0);
    float accw = 0.0;
    add_tap(acc, accw, vec2(0.0, -1.0) - pp, dir, len2, lob, clp, b);
    add_tap(acc, accw, vec2(1.0, -1.0) - pp, dir, len2, lob, clp, c);
    add_tap(acc, accw, vec2(-1.0, 1.0) - pp, dir, len2, lob, clp, i);
    add_tap(acc, accw, vec2(0.0, 1.0) - pp, dir, len2, lob, clp, j);
    add_tap(acc, accw, vec2(0.0, 0.0) - pp, dir, len2, lob, clp, f);
    add_tap(acc, accw, vec2(-1.0, 0.0) - pp, dir, len2, lob, clp, e);
    add_tap(acc, accw, vec2(1.0, 1.0) - pp, dir, len2, lob, clp, k);
    add_tap(acc, accw, vec2(2.0, 1.0) - pp, dir, len2, lob, clp, l);
    add_tap(acc, accw, vec2(2.0, 0.0) - pp, dir, len2, lob, clp, h);
    add_tap(acc, accw, vec2(1.0, 0.0) - pp, dir, len2, lob, clp, gg);
    add_tap(acc, accw, vec2(1.0, 2.0) - pp, dir, len2, lob, clp, o);
    add_tap(acc, accw, vec2(0.0, 2.0) - pp, dir, len2, lob, clp, n);

    // no ringing: within the four nearest texels
    const vec3 mn = min(min(f, gg), min(j, k)), mx = max(max(f, gg), max(j, k));
    vec3 pix = accw != 0.0 ? acc / accw : f;
    pix = clamp(pix, mn, mx);
    // (a NaN or infinite texel in the scene, the bloom's white flash: the nearest texel's colour instead, as the
    // stand-in's own NaN guard does with its history)
    if (any(isnan(pix)) || any(isinf(pix))) pix = f;
    if (any(isnan(pix)) || any(isinf(pix))) pix = vec3(0.0);
    imageStore(dst, g, vec4(pix, 1.0));
}
